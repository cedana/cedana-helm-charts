#!/usr/bin/env bpftrace
/*
 * cuda-copy-hist.bt -- CED-2538. Per-call size and latency distributions for the driver calls a
 * long-prompt prefill burst actually makes, on BOTH sides of the split-process design, so cedana
 * overhead can be separated from driver cost rather than inferred.
 *
 * WHY THIS AND NOT THE BUILT-IN PROFILER: CEDANA_GPU_PROFILING_ENABLED keeps only call_count and
 * total_duration_cycles per function (src/common/cuda_tsc_profiler.h), i.e. averages, and dumps
 * only on SIGTERM. A multi-second stall among millions of calls does not move a mean. This script
 * keeps distributions and prints an outlier line per slow call, which is the whole point.
 *
 * ---------------------------------------------------------------------------------------------
 * SYMBOL NAMES -- READ THIS BEFORE EDITING
 *
 * src/intercepter/hooks/driver_api.cpp:50-67 remaps every memcpy entry point to its _v2 name:
 *     #define cuMemcpyDtoHAsync cuMemcpyDtoHAsync_v2
 * so libcedana-gpu.so exports cuMemcpyDtoHAsync_v2 and NOT cuMemcpyDtoHAsync. A probe on the
 * unsuffixed name attaches to nothing and prints nothing -- it does not error, it just silently
 * reports no copies, which reads exactly like "the staging path is not being taken". Do not
 * trust an empty result without checking attachment first:
 *     nm -D /usr/local/lib/libcedana-gpu.so | grep -E 'cuMemcpy(Dto|Hto)[HD]'
 * cuMemHostRegister and cuModuleLoad* are NOT remapped, so those stay unsuffixed on the
 * interceptor. The real libcuda exports both cuMemHostRegister and cuMemHostRegister_v2, hence
 * the wildcard on that side.
 *
 * PATHS are substituted by watcher/attach.sh, which resolves them from /proc/<pid>/maps rather
 * than assuming a layout -- the interceptor is bind-mounted into the application container by the
 * runtime shim, so its path differs between the host's and the container's view, and a uprobe
 * attaches by inode. __LIBCUDA__ may be empty if no worker had libcuda mapped yet, in which case
 * attach.sh drops that section; expect only INTERCEPTOR rows then.
 * ---------------------------------------------------------------------------------------------
 *
 * READING IT. "comm" tells you which side a row came from: the application ranks show as python3 /
 * sglang::*, the GPU worker shows as cedana-gpu-cont (comm truncates at 15 chars).
 *
 *   @copy_bytes[...]      size distribution per function. THE fingerprint: a tall spike at exactly
 *                         16777216 means copies are being split by kMaxShmCopyBytes
 *                         (hooks/driver_api.cpp:2453), which only happens when isHostMem() is
 *                         false -- i.e. the host buffer is not a published region and every chunk
 *                         costs a segment allocation, a round trip and an extra host->host memcpy.
 *                         @copy_16m counts those exactly. Native has no such spike at all.
 *   @copy_us[...]        latency distribution per function.
 *   @hostreg_us          cuMemHostRegister latency. Watch for ~1 s: host_mem.cpp:907-913 retries
 *                        a shared-anonymous pool that another process maps every 50 ms for up to
 *                        1 s, then fails. TP8 means 8 rank processes, so this is reachable.
 *   @hostreg_fail[ret]   non-zero CUresult from cuMemHostRegister. ANY row here is significant:
 *                        every later copy on that buffer takes the staging path above. 801 is
 *                        CUDA_ERROR_NOT_SUPPORTED, 712 is HOST_MEMORY_ALREADY_REGISTERED,
 *                        208 is ALREADY_MAPPED.
 *   @modload_us          cuModuleLoad/LoadData/LoadFatBinary latency, and @modload_n its count.
 *                        If the tail decays over a burst run this is the suspect; if it persists
 *                        it is not.
 *   SLOW lines           any single call over THRESH_MS, with mono+wall timestamps so it joins to
 *                        the bench's JSONL and the watcher's snapshots.
 *
 * Run (attach.sh does this for you):
 *   bpftrace -f text cuda-copy-hist.rendered.bt
 */

BEGIN
{
	@THRESH_MS = 50;                /* outlier line above this; raise if the log floods */
	@CHUNK = (uint64)16777216;      /* kMaxShmCopyBytes, hooks/driver_api.cpp:2453 */
	printf("# ced-2538 cuda-copy-hist attached; outliers above %d ms\n", @THRESH_MS);
	printf("# mono=<boot ns> wall=<epoch s> EVENT comm pid tid detail\n");
}

/* ------------------------------------------------------------------ interceptor: host copies */
uprobe:__LIB__:cuMemcpyDtoHAsync_v2,
uprobe:__LIB__:cuMemcpyHtoDAsync_v2,
uprobe:__LIB__:cuMemcpyDtoH_v2,
uprobe:__LIB__:cuMemcpyHtoD_v2
{
	@cstart[tid] = nsecs;
	/* arg2 is byteCount for all four: (dst, src, byteCount[, stream]) */
	@csize[tid] = arg2;
	@cfunc[tid] = func;
}

uretprobe:__LIB__:cuMemcpyDtoHAsync_v2,
uretprobe:__LIB__:cuMemcpyHtoDAsync_v2,
uretprobe:__LIB__:cuMemcpyDtoH_v2,
uretprobe:__LIB__:cuMemcpyHtoD_v2
/@cstart[tid]/
{
	$us = (nsecs - @cstart[tid]) / 1000;
	$sz = @csize[tid];
	@copy_bytes[@cfunc[tid]] = hist($sz);
	@copy_us[@cfunc[tid]] = hist($us);
	@copy_n[comm, @cfunc[tid]] = count();
	@copy_total_bytes[comm] = sum($sz);
	if ($sz == @CHUNK) {
		@copy_16m[comm, @cfunc[tid]] = count();
	}
	if ($us > @THRESH_MS * 1000) {
		printf("mono=%llu wall=%s SLOW-COPY %s %d %d %s bytes=%llu us=%llu\n",
		       nsecs, strftime("%s.%f", nsecs),
		       comm, pid, tid, @cfunc[tid], $sz, $us);
	}
	delete(@cstart[tid]); delete(@csize[tid]); delete(@cfunc[tid]);
}

/* --------------------------------------------- GENERIC AND BATCH COPY ENTRY POINTS
 * The typed probes above (cuMemcpyDtoH/HtoD and their Async forms) stayed FLAT between the direct
 * and kernel backends -- 9,360 vs 9,228 calls -- while PCIe host->device showed an 8x lower
 * ceiling on the kernel backend (1.76 GB/s peak vs 0.215, never exceeded). Identical counts across
 * a backend change that plainly moved bytes differently means those probes are not on the transfer
 * path at all; what they see is something else, most likely write-through.
 *
 * These are the doors the transfer can actually use. A framework moving pinned host memory reaches
 * for the generic forms, and cedana's own host-registration docs call out cuMemcpyBatchAsync by
 * name. Probing only the typed entry points was the gap.
 *
 * Byte counts where the signature gives one: cuMemcpy/cuMemcpyAsync take (dst, src, ByteCount),
 * cuMemcpyPeerAsync takes (dst, dstCtx, src, srcCtx, ByteCount). The 2D/3D and batch forms take
 * descriptor structs, so they are counted but not sized -- a non-zero count there is still the
 * answer to "which call is it".
 *
 * COST: cuMemcpyAsync also carries device-to-device traffic, so this is busier than the typed
 * probes. Histograms only, no per-event printf except slow calls. */
uprobe:__LIB__:cuMemcpyAsync,
uprobe:__LIB__:cuMemcpy
{
	@gstart[tid] = nsecs;
	@gsize[tid] = arg2;
	@gfunc[tid] = func;
}

uprobe:__LIB__:cuMemcpyPeerAsync
{
	@gstart[tid] = nsecs;
	@gsize[tid] = arg4;
	@gfunc[tid] = func;
}

uprobe:__LIB__:cuMemcpyBatchAsync*,
uprobe:__LIB__:cuMemcpy2DAsync_v2,
uprobe:__LIB__:cuMemcpy3DAsync_v2
{
	@gstart[tid] = nsecs;
	@gsize[tid] = 0;          /* descriptor struct: counted, not sized */
	@gfunc[tid] = func;
}

uretprobe:__LIB__:cuMemcpyAsync,
uretprobe:__LIB__:cuMemcpy,
uretprobe:__LIB__:cuMemcpyPeerAsync,
uretprobe:__LIB__:cuMemcpyBatchAsync*,
uretprobe:__LIB__:cuMemcpy2DAsync_v2,
uretprobe:__LIB__:cuMemcpy3DAsync_v2
/@gstart[tid]/
{
	$us = (nsecs - @gstart[tid]) / 1000;
	@gcopy_n[comm, @gfunc[tid]] = count();
	@gcopy_us[@gfunc[tid]] = hist($us);
	if (@gsize[tid] > 0) {
		@gcopy_bytes[@gfunc[tid]] = hist(@gsize[tid]);
		@gcopy_total[comm, @gfunc[tid]] = sum(@gsize[tid]);
	}
	if ($us > @THRESH_MS * 1000) {
		printf("mono=%llu wall=%s SLOW-GCOPY %s %d %d %s bytes=%llu us=%llu\n",
		       nsecs, strftime("%s.%f", nsecs), comm, pid, tid, @gfunc[tid], @gsize[tid], $us);
	}
	delete(@gstart[tid]); delete(@gsize[tid]); delete(@gfunc[tid]);
}

/* -------------------------------------------------- interceptor: host memory registration */
uprobe:__LIB__:cuMemHostRegister
{
	@hrstart[tid] = nsecs;
	@hrsize[tid] = arg1;            /* (void* p, size_t bytesize, unsigned Flags) */
	@hrptr[tid] = arg0;
	printf("mono=%llu wall=%s HOSTREG-ENTER %s %d %d ptr=0x%lx bytes=%llu\n",
	       nsecs, strftime("%s.%f", nsecs),
	       comm, pid, tid, arg0, arg1);
}

uretprobe:__LIB__:cuMemHostRegister
/@hrstart[tid]/
{
	$us = (nsecs - @hrstart[tid]) / 1000;
	@hostreg_us = hist($us);
	@hostreg_bytes = hist(@hrsize[tid]);
	@hostreg_n[comm] = count();
	if (retval != 0) {
		@hostreg_fail[retval] = count();
	}
	/* Always printed: there are few of these and each one decides whether every subsequent copy
	 * on that buffer runs in place or through the shm segment. */
	printf("mono=%llu wall=%s HOSTREG-EXIT %s %d %d ptr=0x%lx bytes=%llu ret=%d us=%llu\n",
	       nsecs, strftime("%s.%f", nsecs),
	       comm, pid, tid, @hrptr[tid], @hrsize[tid], retval, $us);
	delete(@hrstart[tid]); delete(@hrsize[tid]); delete(@hrptr[tid]);
}

uprobe:__LIB__:cuMemHostUnregister
{
	@hostunreg_n[comm] = count();
}

/* ------------------------------------------------- interceptor: PINNED HOST ALLOCATION
 * The native run showed ZERO cuMemHostRegister calls while HiCache was plainly doing async host
 * copies, which means the pool is ALLOCATED pinned (cuMemHostAlloc / cuMemAllocHost) rather than
 * registered after the fact. Those are different entry points, so the registration probes above
 * see nothing and the real pinning cost was invisible. Both exist in libcuda and in the
 * interceptor, so this attaches on both sides.
 *   Note the asymmetry in names: cuMemAllocHost is remapped to _v2 by the interceptor, while
 *   cuMemHostAlloc and cuMemFreeHost are not.
 * Watch @pinalloc_bytes for the 128 GiB pool arriving, and @pinalloc_us for how long pinning it
 * blocks -- a multi-second pin inside a request's forward is a direct TTFT stall. */
uprobe:__LIB__:cuMemHostAlloc
{
	@pastart[tid] = nsecs;
	@pasize[tid] = arg1;            /* (void** pp, size_t bytesize, unsigned int flags) */
	@pafunc[tid] = func;
	/* THE FLAGS ARE THE POINT. CU_MEMHOSTALLOC_DEVICEMAP (0x02) maps the host allocation into the
	 * device address space, which is how a device KERNEL reads host memory directly -- demand-driven
	 * reads over PCIe rather than a DMA-engine burst. That is a plausible mechanism for the 8x lower
	 * host->device ceiling the kernel backend showed (0.215 GB/s vs 1.76). WRITECOMBINED (0x04)
	 * matters too: it is fast to write from the host and very slow to read.
	 *   0x01 PORTABLE | 0x02 DEVICEMAP | 0x04 WRITECOMBINED  */
	@paflags[tid] = arg2;
	@pinalloc_flags[arg2] = count();
}

uprobe:__LIB__:cuMemAllocHost_v2
{
	@pastart[tid] = nsecs;
	@pasize[tid] = arg1;            /* (void** pp, size_t bytesize) -- no flags argument */
	@pafunc[tid] = func;
	@paflags[tid] = 0;
}

uretprobe:__LIB__:cuMemHostAlloc,
uretprobe:__LIB__:cuMemAllocHost_v2
/@pastart[tid]/
{
	$us = (nsecs - @pastart[tid]) / 1000;
	@pinalloc_us[@pafunc[tid]] = hist($us);
	@pinalloc_bytes[@pafunc[tid]] = hist(@pasize[tid]);
	@pinalloc_n[comm, @pafunc[tid]] = count();
	@pinalloc_total[comm] = sum(@pasize[tid]);
	if (retval != 0) {
		@pinalloc_fail[retval] = count();
	}
	/* Always printed: these are few, large, and each one decides how a whole pool behaves. */
	printf("mono=%llu wall=%s PINALLOC %s %d %d %s bytes=%llu flags=0x%lx ret=%d us=%llu\n",
	       nsecs, strftime("%s.%f", nsecs),
	       comm, pid, tid, @pafunc[tid], @pasize[tid], @paflags[tid], retval, $us);
	delete(@pastart[tid]); delete(@pasize[tid]); delete(@pafunc[tid]); delete(@paflags[tid]);
}

uprobe:__LIB__:cuMemFreeHost
{
	@pinfree_n[comm] = count();
}

/* ------------------------------------------- interceptor: host pointer -> device pointer
 * With --hicache-io-backend kernel, load-back is a device KERNEL reading the pinned host pool
 * directly -- it never calls cuMemcpy, so the copy probes above go quiet and that silence is not
 * evidence of nothing happening. To read host memory a kernel needs a device address for it, and
 * this is the call that hands one out. Under cedana the worker must have the pool mapped at the
 * same address for that pointer to be valid, so a slow or failing call here is directly on the
 * kernel-backend load-back path. Low frequency: safe to probe continuously. */
uprobe:__LIB__:cuMemHostGetDevicePointer*
{
	@hgdstart[tid] = nsecs;
}

uretprobe:__LIB__:cuMemHostGetDevicePointer*
/@hgdstart[tid]/
{
	$us = (nsecs - @hgdstart[tid]) / 1000;
	@hostdevptr_us = hist($us);
	@hostdevptr_n[comm] = count();
	if (retval != 0) { @hostdevptr_fail[retval] = count(); }
	printf("mono=%llu wall=%s HOSTDEVPTR %s %d %d ret=%d us=%llu\n",
	       nsecs, strftime("%s.%f", nsecs), comm, pid, tid, retval, $us);
	delete(@hgdstart[tid]);
}

/* --------------------------------------------------------- interceptor: module / JIT loading */
uprobe:__LIB__:cuModuleLoad,
uprobe:__LIB__:cuModuleLoadData,
uprobe:__LIB__:cuModuleLoadFatBinary
{
	@mstart[tid] = nsecs;
	@mfunc[tid] = func;
}

uretprobe:__LIB__:cuModuleLoad,
uretprobe:__LIB__:cuModuleLoadData,
uretprobe:__LIB__:cuModuleLoadFatBinary
/@mstart[tid]/
{
	$us = (nsecs - @mstart[tid]) / 1000;
	@modload_us[@mfunc[tid]] = hist($us);
	@modload_n[comm, @mfunc[tid]] = count();
	if ($us > @THRESH_MS * 1000) {
		printf("mono=%llu wall=%s SLOW-MODLOAD %s %d %d %s us=%llu ret=%d\n",
		       nsecs, strftime("%s.%f", nsecs),
		       comm, pid, tid, @mfunc[tid], $us, retval);
	}
	delete(@mstart[tid]); delete(@mfunc[tid]);
}

/* >>>LIBCUDA_SECTION (watcher/attach.sh deletes to <<<LIBCUDA_SECTION when no worker libcuda) */
/* --------------------------------------------------------------- real driver, worker-side cost
 * Same calls as measured by the driver itself. @copy_us minus @drv_copy_us for the same size
 * bucket is cedana's share; without this section a slow copy cannot be blamed on either side.
 * attach.sh removes this block when no worker has libcuda mapped. */
uprobe:__LIBCUDA__:cuMemcpyDtoHAsync_v2,
uprobe:__LIBCUDA__:cuMemcpyHtoDAsync_v2,
uprobe:__LIBCUDA__:cuMemcpyDtoH_v2,
uprobe:__LIBCUDA__:cuMemcpyHtoD_v2
{
	@dstart[tid] = nsecs;
	@dsize[tid] = arg2;
	@dfunc[tid] = func;
}

uretprobe:__LIBCUDA__:cuMemcpyDtoHAsync_v2,
uretprobe:__LIBCUDA__:cuMemcpyHtoDAsync_v2,
uretprobe:__LIBCUDA__:cuMemcpyDtoH_v2,
uretprobe:__LIBCUDA__:cuMemcpyHtoD_v2
/@dstart[tid]/
{
	$us = (nsecs - @dstart[tid]) / 1000;
	@drv_copy_us[@dfunc[tid]] = hist($us);
	@drv_copy_bytes[@dfunc[tid]] = hist(@dsize[tid]);
	@drv_copy_n[comm, @dfunc[tid]] = count();
	delete(@dstart[tid]); delete(@dsize[tid]); delete(@dfunc[tid]);
}

uprobe:__LIBCUDA__:cuMemHostRegister*
{
	@drv_hrstart[tid] = nsecs;
}

uretprobe:__LIBCUDA__:cuMemHostRegister*
/@drv_hrstart[tid]/
{
	$us = (nsecs - @drv_hrstart[tid]) / 1000;
	@drv_hostreg_us = hist($us);
	printf("mono=%llu wall=%s DRV-HOSTREG %s %d %d ret=%d us=%llu\n",
	       nsecs, strftime("%s.%f", nsecs),
	       comm, pid, tid, retval, $us);
	delete(@drv_hrstart[tid]);
}

/* <<<LIBCUDA_SECTION */

/* ----------------------------------------------------------------------------- periodic dump
 * Printed and cleared every 10 s so each burst window can be read on its own; a single cumulative
 * histogram at exit would smear the bursts into the idle gaps and hide the thing we are after. */
interval:s:10
{
	printf("\n===== ced-2538 window end mono=%llu wall=%s =====\n",
	       nsecs, strftime("%s.%f", nsecs));
	print(@copy_n); print(@copy_16m); print(@copy_total_bytes);
	print(@copy_bytes); print(@copy_us);
	print(@gcopy_n); print(@gcopy_total); print(@gcopy_bytes); print(@gcopy_us);
	print(@hostreg_n); print(@hostreg_fail); print(@hostreg_us); print(@hostreg_bytes);
	print(@pinalloc_n); print(@pinalloc_total); print(@pinalloc_us); print(@pinalloc_bytes);
	print(@hostdevptr_n); print(@hostdevptr_us);
	print(@modload_n); print(@modload_us);
	print(@drv_copy_n); print(@drv_copy_us); print(@drv_copy_bytes); print(@drv_hostreg_us);
	clear(@copy_n); clear(@copy_16m); clear(@copy_total_bytes);
	clear(@copy_bytes); clear(@copy_us);
	clear(@gcopy_n); clear(@gcopy_total); clear(@gcopy_bytes); clear(@gcopy_us);
	clear(@hostreg_us); clear(@hostreg_bytes);
	clear(@pinalloc_us); clear(@pinalloc_bytes);
	clear(@hostdevptr_us);
	clear(@modload_n); clear(@modload_us);
	clear(@drv_copy_n); clear(@drv_copy_us); clear(@drv_copy_bytes); clear(@drv_hostreg_us);
	/* @hostreg_n, @hostreg_fail and @hostunreg_n are deliberately NOT cleared: they are small,
	 * cumulative, and a single failure anywhere in the run is the headline result. */
}

END
{
	printf("\n===== ced-2538 cumulative =====\n");
	print(@hostreg_n); print(@hostreg_fail); print(@hostunreg_n);
	print(@pinalloc_n); print(@pinalloc_total); print(@pinalloc_fail); print(@pinfree_n);
	print(@pinalloc_flags);
	print(@hostdevptr_n); print(@hostdevptr_fail);
	clear(@cstart); clear(@csize); clear(@cfunc);
	clear(@hrstart); clear(@hrsize); clear(@hrptr);
	clear(@mstart); clear(@mfunc);
	clear(@pastart); clear(@pasize); clear(@pafunc); clear(@paflags);
	clear(@hgdstart);
	clear(@gstart); clear(@gsize); clear(@gfunc);
	clear(@dstart); clear(@dsize); clear(@dfunc); clear(@drv_hrstart);
	clear(@THRESH_MS); clear(@CHUNK);
}
